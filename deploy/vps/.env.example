# Copy to .env beside this file (scripts/vps-install.sh writes it for you).
# Only DOMAIN and the x402 pair are needed to take money; everything else is
# optional and its rail simply stays off (fail-closed) until set.

# --- required ---------------------------------------------------------------

# The domain Caddy serves and every manifest advertises. Its DNS A record
# must point at this box before Caddy can obtain a certificate.
DOMAIN=audits.example.com

# x402: the rail that takes $0.05 with no account. The facilitator verifies
# and settles; the pay-to is YOUR self-custody Base wallet. Revenue lands
# on-chain in that wallet -- the wallet is the counter.
#
# PayAI: keyless, settles on Base mainnet AND runs a /discovery/resources
# index that x402scan aggregates. A facilitator's index is the ONLY way a
# paid call registers this node so agents can find it by capability.
# xpay.sh settles but indexes nothing; Dexter indexes but its settlement
# signer ran out of gas (read 2026-09-12), and a facilitator that cannot
# settle sells nothing. To change it on a running box, never by hand -- the
# node refuses to advertise a rail its facilitator cannot verify, so a bad
# URL silently stops all sales while /health still answers 200:
#     bash scripts/switch-facilitator.sh https://...
# which reads the live 402 afterwards and rolls back if the rail is gone.
X402_FACILITATOR_URL=https://facilitator.payai.network

# Coinbase CDP (optional): the facilitator behind the x402 Bazaar, the index
# the official x402 SDKs read by default. Needs a CDP API key (Ed25519 or
# ES256; the secret is the key's private part, exactly as the CDP portal
# hands it out). Used only when X402_FACILITATOR_URL names a Coinbase host;
# with any other facilitator the pair is ignored and a warning is logged.
# Switch with:  bash scripts/switch-facilitator.sh https://api.cdp.coinbase.com/platform/v2/x402
# CDP_API_KEY_ID=...
# CDP_API_KEY_SECRET=...

# Solana (optional second rail): USDC on Solana mainnet into a Solana address
# you hold -- the Base app shows one beside the Ethereum address. Advertised
# only when the address parses and the facilitator lists Solana with a fee
# payer (PayAI, Dexter and Coinbase all do); otherwise it stays off and Base
# is unaffected. The v1 body stays Base-only; the v2 header carries both.
# X402_SOLANA_PAY_TO_ADDRESS=...
X402_PAY_TO_ADDRESS=0x837C40E2B4e976f43Ffb4451eE281A00fA9477dd

# --- capacity ---------------------------------------------------------------

# Each in-flight audit holds a Chromium context; this is a memory ceiling,
# not a CPU one. 2 fits a 4 GB box beside the OS. Raise it together with
# mem_limit in docker-compose.yml when the box grows.
MAX_CONCURRENT_AUDITS=2

# --- optional: Stripe rails (subscriptions, MPP top-up, one-off reports) ----
# Unset = those rails are not advertised and cannot be half-on.

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...
# STRIPE_PRICE_ONEOFF_REPORT=price_...
# MPP_STRIPE_NETWORK_PROFILE_ID=profile_...
# MPP_TEMPO_RECIPIENT_ADDRESS=0x...   # a Stripe-minted Tempo deposit address
# MPP `evm` hash rail (USDC on Base, payer sends the transfer itself and
# presents the tx hash; for smart-wallet payers whose signatures no x402
# facilitator verifies). Off unless the recipient is set. Needs
# STRIPE_SECRET_KEY or MPP_CHALLENGE_SECRET to sign challenges.
# MPP_EVM_RECIPIENT_ADDRESS=0x837C40E2B4e976f43Ffb4451eE281A00fA9477dd
# MPP_CHALLENGE_SECRET=<long random string>
# MPP_EVM_MAX_BASE_UNITS=10000000     # $10 ceiling on this rail (spec: low value only)

# --- optional: worker network (/work/*) --------------------------------------
# Every worker follows the same rule as the payment rails: one with no
# configured provider is absent from every advertised surface, never
# advertised broken. The keyless workers (chain.*, market.quote/rates/
# ticker, prediction.*, extract.page, fetch.raw) are live with nothing
# below set -- they need only outbound HTTPS, same as the audits.

# Google Cloud credentials, shared by every Vertex/BigQuery-backed worker
# (llm.analyze/extract/generate, code.execute, image.generate,
# speech.synthesize/transcribe, data.query/question/forecast/anomalies,
# search.web, research.*, market.intel, monitor.check, video.generate) --
# the same Application Default Credentials the audits' AI remediation notes
# already use. A service-account JSON on this box:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/hubvibe/gcp-service-account.json
# WORKER_GCP_PROJECT=...        # only if ADC does not already resolve one

# WORKER_LEDGER_PATH=/data/hubvibe-workers.db   # per-call revenue/cost ledger
# WORKER_ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5,claude-opus-5
# WORKER_ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5
#   ^ enables llm.generate's provider=anthropic option once Claude is
#   enabled in this project's Vertex Model Garden (console: Vertex AI >
#   Model Garden > Claude > Enable, accepting its data-sharing terms) --
#   no separate Anthropic API key needed, it bills to this GCP project.

# maps.places/route/weather use Google's managed Maps Grounding Lite MCP
# server (API already enabled on resolver-time). Either:
# MAPS_GROUNDING_LITE_API_KEY=...   # a key restricted to that API, or
# WORKER_MAPS_ADC=1                 # the service account above, re-scoped to
#   maps-platform.mapstools -- proven on this box 2026-09-19 (all three tools answered)
#   (scripts/simulate-work-calls.py --only /work/maps/weather). Neither set =
#   the three maps workers stay unadvertised.

# video.generate runs Veo 3.1 Fast (veo-3.1-fast-generate-001, proven live
# 2026-09-18) on the credentials above; no extra switch.

# Provider cost rates for the worker ledger. The code defaults to Google's
# published list prices (read 2026-09-19): Gemini per model on the global
# endpoint, reasoning tokens billed as output (3.8 Flash's intro rate ends
# 2027-01-01 and doubles automatically); Search grounding $0.014/query;
# BigQuery $6.25/TiB; Veo 3.1 Fast $0.10/s; image $0.04. Set these only to
# override (e.g. a negotiated rate). Speech-to-Text has no default yet.
# GEMINI_PRICE_PER_MTOK_IN=...  GEMINI_PRICE_PER_MTOK_OUT=...   # both, or neither
# WORKER_SEARCH_PRICE_PER_QUERY_USD=0.014
# BQ_PRICE_PER_TIB=6.25
# WORKER_STT_PRICE_PER_MIN_USD=...
# WORKER_IMAGE_PRICE_USD=0.04
# WORKER_VEO_PRICE_PER_SECOND_USD=0.10

# --- optional: extras -------------------------------------------------------

# GEMINI_API_KEY=...        # AI remediation notes on wcag results only --
#                           # the workers above use Vertex ADC, not this key
# AUDIT_API_KEY=...         # internal unmetered test key; leave unset in prod
